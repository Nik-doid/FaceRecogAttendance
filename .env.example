# ---------------------------------------------------------------------------
# Face Recognition Service — configuration reference
# Every value can be overridden with real environment variables.
# Copy to `.env` and adjust.
# ---------------------------------------------------------------------------

APP_ENV=production
LOG_LEVEL=INFO
# Silences the onnxruntime and core-OpenCV native loggers, which write to stderr and
# ignore LOG_LEVEL. Turn off to diagnose ONNX problems.
QUIET_NATIVE_LOGS=true
#
# OpenCV's RTSP/FFmpeg chatter ("[ WARN:0@..] global cap_ffmpeg_impl.hpp ...",
# "[h264 @ ..] error while decoding MB") canNOT be turned off from this file. The cv2
# DLL reads its environment when the process starts, before any Python runs, so these
# must be REAL environment variables exported before launching:
#
#   PowerShell:  $env:OPENCV_LOG_LEVEL="ERROR"; $env:OPENCV_FFMPEG_LOGLEVEL="8"
#   bash:        export OPENCV_LOG_LEVEL=ERROR OPENCV_FFMPEG_LOGLEVEL=8
#
# docker-compose.yml already sets both for the app service.

# --- Camera -----------------------------------------------------------------
CAMERA_ID=cam-01
# "rtsp" for IP/RTSP cameras (production); "device" for a local webcam (testing).
CAMERA_SOURCE=rtsp
RTSP_URL=rtsp://user:pass@192.168.1.64:554/stream1
# Webcam device index (0 = first camera). Used when CAMERA_SOURCE=device.
CAMERA_DEVICE_INDEX=0
CAMERA_AUTOSTART=false
FRAME_SKIP=2                 # process every Nth frame
MAX_FRAME_WIDTH=1280

# Camera WebSocket streaming endpoint: /api/v1/camera/ws
# Streams JPEG frames from the configured source (RTSP or device) and runs the
# palm -> face -> recognition pipeline over them.
# Set CAMERA_SOURCE=rtsp and RTSP_URL for IP cameras.
# Set CAMERA_SOURCE=device and CAMERA_DEVICE_INDEX for local webcam.
# Run the pipeline on every Nth streamed frame. Detection runs on a background task,
# so this caps CPU rather than the frame rate. At ~30fps, 10 is a scan every ~330ms.
CAMERA_DETECT_EVERY=10

# --- Palm detection (gates the /webcam/ws and /camera/ws pipeline) -----------
PALM_SCORE_THRESHOLD=0.50
# BlazePalm squashes the frame to 192x192, so a palm 5m from a 1280px-wide CCTV feed
# shrinks to a handful of pixels and is never found. PALM_SCAN_GRID scans NxN
# overlapping crops instead, multiplying the palm's effective resolution by N.
# Costs up to N*N+1 forward passes; one pass measured ~72ms on a 4-core CPU, so
# grid 2 is ~280ms per scan and grid 3 ~720ms. Raise it only if palms at your camera
# distance still go undetected, and raise CAMERA_DETECT_EVERY with it.
# Applies to /camera/ws only; /webcam/ws keeps the cheap whole-frame scan.
PALM_SCAN_GRID=2
PALM_SCAN_OVERLAP=0.20

# --- Looking gate -----------------------------------------------------------
# Palm detection and recognition run only for faces turned toward the camera; an
# empty room or a room of people facing away costs one face-detection pass and stops.
# LOOKING_MAX_YAW_RATIO is the nose's offset along the eye axis over the eye span:
# frontal faces measure <=0.03, a turned head 0.76. Raise it to accept more angled
# faces, lower it to demand a straighter look.
# Head pitch is deliberately NOT gated -- a high-mounted CCTV sees every face pitched.
LOOKING_MAX_YAW_RATIO=0.35
LOOKING_MAX_ROLL_DEGREES=25.0
# Each looking face gets its own palm search box, and only the people whose own box
# contains a hand are recognised -- a bystander beside someone who waves is never
# identified. Measured in face widths to each side (and face heights below).
#
# This is the knob that decides WHOSE hand it is, so keep it tight: a wide box reaches
# into the next person's space and both register the same hand. On a real two-person
# capture, 0.4 scored 0.14 vs 0.94 across the pair, while 1.0 scored 0.98 vs 0.96 and
# wrongly identified both. Widen only if people wave far out to the side, and expect
# to give up per-person attribution when you do.
#
# BlazePalm's score is noisy under reframing -- the same hand measured 0.24 at 0.6 and
# 0.12 at 0.4 -- so tune this together with PALM_SCORE_THRESHOLD on your own footage.
PALM_SEARCH_MARGIN=0.6

# --- Recognition ------------------------------------------------------------
RECOGNITION_THRESHOLD=0.60   # cosine similarity / normalized confidence threshold
DUPLICATE_TIMEOUT_SECONDS=300  # suppress repeat report for same employee within this window
MINIMUM_FACE_SIZE=80         # min face bbox side in px
LIVENESS_ENABLED=true
SILENTFACE_THRESHOLD=0.50
TRACKING_ENABLED=false

# --- Face quality gates ------------------------------------------------------
# Faces failing these are skipped (enrollment + live). QUALITY_MIN_BLUR is the
# Laplacian-variance floor; lower = more tolerant of blurry input.
QUALITY_MIN_BLUR=100
QUALITY_MIN_LIGHTING=40
QUALITY_MAX_LIGHTING=220
QUALITY_MAX_ROLL_DEG=30

# --- AI model paths (insightface downloads into these dirs on first use) ----
MODELS_DIR=./models
DETECT_MODEL=det_10g.onnx    # SCRFD-10g, from buffalo_l pack
RECOGNIZE_MODEL=w600k_r50.onnx    # ArcFace 512-d, from buffalo_l pack
SILENTFACE_MODEL_PATH=./models/silentface.onnx  # optional; if unset + liveness on -> fail fast
MODELS_AUTO_DOWNLOAD=true    # fetch missing det/arcface/hand models into MODELS_DIR on first boot

# ONNX execution providers (order = preference). CPU fallback is automatic.
ONNX_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider

# --- Employee photo source ---------------------------------------------------
# Comma-separated. Each entry is either a local directory or an https:// URL of a
# folder laid out the same way: one subdirectory per employee_code, holding at least
# one face photo (uploads/employees/EMP1023/EMP1023.jpg). Both kinds can be listed
# together; an employee present in two sources simply gets more reference vectors,
# which improves matching rather than conflicting.
EMPLOYEE_PHOTOS_SOURCE=./uploads/employees
# EMPLOYEE_PHOTOS_SOURCE=./uploads/employees,https://hr.example.com/employee-photos/
#
# A remote folder is enumerated from {BASE}/manifest.json if one exists:
#   {"employees": {"EMP1023": [{"file": "front.jpg", "etag": "W/\"a1b2\""}]}}
# The plain form {"EMP1023": ["front.jpg"]} works too. Without a manifest the
# server's directory listing is scraped instead, which works on nginx/Apache
# autoindex but NOT on object stores (S3/MinIO answer with XML). Publish a
# manifest if you can -- the ETags also let restarts skip re-downloading.
# Sent with every remote request, as "Header-Name: value".
EMPLOYEE_PHOTOS_AUTH_HEADER=
EMPLOYEE_PHOTOS_TIMEOUT_SECONDS=15.0
EMPLOYEE_PHOTOS_MANIFEST=manifest.json
# Re-enumerate and re-embed on this interval so a new hire appears without a
# restart. 0 disables it.
GALLERY_REFRESH_SECONDS=3600
#
# Embeddings are cached under STORAGE_PATH/gallery and reused when a photo has not
# changed. This is what keeps a restart to seconds: measured here, enrolling 5
# photos over HTTP took 12.5s cold and 0.2s warm. Deleting the cache costs time and
# nothing else.

# --- Attendance reporting (message queue) ------------------------------------
# This service publishes attendance events; the EXISTING attendance system consumes.
ATTENDANCE_BROKER=rabbitmq   # rabbitmq | null
ATTENDANCE_MQ_URL=amqp://guest:guest@rabbitmq:5672/
ATTENDANCE_EXCHANGE=attendance.events
ATTENDANCE_ROUTING_KEY=checkin
ATTENDANCE_QUEUE=attendance.checkin

# --- Attendance log sync to an external ERP/DB (cron) ------------------------
# Writes attendance punches to an external MySQL table. Disabled by default.
ERP_SYNC_ENABLED=false        # true to run the interval scheduler / allow /sync API
ERP_DB_HOST=localhost
ERP_DB_PORT=3306
ERP_DB_NAME=attendance
ERP_DB_USER=root
ERP_DB_PASSWORD=
# JSON map of camera_id -> {"device_id": <int>, "branch_id": <int>}
ERP_CAMERA_MAPPING={"cam-01":{"device_id":1,"branch_id":1}}
ERP_VERIFY_MODE=FACE
ERP_CREATED_BY=system
# Emp code -> attendance id lookup (emp_code -> emp_id, written as attendance_id_no in the log).
ERP_EMPLOYEE_TABLE=ct_hr_employee_master
ERP_EMPLOYEE_CODE_COLUMN=emp_code
ERP_EMPLOYEE_ID_COLUMN=emp_id
# Optional active-employee filter appended to the lookup WHERE.
ERP_EMPLOYEE_ACTIVE_FILTER=_status
# in_out_mode: literal int (e.g. 1), or "toggle" — first punch of the day is
# check-in(1), second is check-out(2), further punches are skipped (never duplicated).
# The rule is seeded from rows already in the target attendance table for the day.
ERP_IN_OUT_MODE=toggle
ERP_SYNC_INTERVAL_SECONDS=300
ERP_SYNC_BATCH_SIZE=500

# --- This service's own database ---------------------------------------------
DATABASE_URL=postgresql+asyncpg://face:face@postgres:5432/face_recognition
# Sync URL used by the background worker (same DB, psycopg driver)
DATABASE_SYNC_URL=postgresql+psycopg://face:face@postgres:5432/face_recognition

# --- Storage ------------------------------------------------------------------
STORAGE_PATH=./storage
UNKNOWN_FACES_DIR=./storage/unknown_faces
SNAPSHOTS_DIR=./storage/snapshots
SNAPSHOT_ENABLED=true

# --- Security -----------------------------------------------------------------
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Static bearer token for the health/read endpoints or fallback auth (optional)
API_TOKEN=
# Simple in-memory rate limit for control endpoints: max requests per window
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# --- API -----------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
