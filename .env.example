# ---------------------------------------------------------------------------
# Face Recognition Service — configuration reference
# Every value can be overridden with real environment variables.
# Copy to `.env` and adjust.
# ---------------------------------------------------------------------------

APP_ENV=production
LOG_LEVEL=INFO

# --- Camera -----------------------------------------------------------------
CAMERA_ID=cam-01
# "rtsp" for IP/RTSP cameras (production); "device" for a local webcam (testing).
CAMERA_SOURCE=rtsp
RTSP_URL=rtsp://user:pass@192.168.1.64:554/stream1
# Webcam device index (0 = first camera). Used when CAMERA_SOURCE=device.
CAMERA_DEVICE_INDEX=0
CAMERA_AUTOSTART=false
FRAME_SKIP=2                 # process every Nth frame
MAX_FRAME_WIDTH=1280

# --- Recognition ------------------------------------------------------------
RECOGNITION_THRESHOLD=0.60   # cosine similarity / normalized confidence threshold
DUPLICATE_TIMEOUT_SECONDS=300  # suppress repeat report for same employee within this window
MINIMUM_FACE_SIZE=80         # min face bbox side in px
LIVENESS_ENABLED=true
SILENTFACE_THRESHOLD=0.50
TRACKING_ENABLED=false

# --- AI model paths (insightface downloads into these dirs on first use) ----
MODELS_DIR=./models
DETECT_MODEL=det_10g.onnx    # SCRFD-10g, from buffalo_l pack
RECOGNIZE_MODEL=w600k_r50.onnx    # ArcFace 512-d, from buffalo_l pack
SILENTFACE_MODEL_PATH=./models/silentface.onnx  # optional; if unset + liveness on -> fail fast

# ONNX execution providers (order = preference). CPU fallback is automatic.
ONNX_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider

# --- Employee photo source (existing system) -------------------------------
# Comma-separated list of root directories. Each subdirectory is an employee_code
# and must contain at least one face photo, e.g. uploads/employees/EMP1023/EMP1023.jpg
EMPLOYEE_PHOTOS_SOURCE=./uploads/employees

# --- Attendance reporting (message queue) ------------------------------------
# This service publishes attendance events; the EXISTING attendance system consumes.
ATTENDANCE_BROKER=rabbitmq   # rabbitmq | null
ATTENDANCE_MQ_URL=amqp://guest:guest@rabbitmq:5672/
ATTENDANCE_EXCHANGE=attendance.events
ATTENDANCE_ROUTING_KEY=checkin
ATTENDANCE_QUEUE=attendance.checkin

# --- This service's own database ---------------------------------------------
DATABASE_URL=postgresql+asyncpg://face:face@postgres:5432/face_recognition
# Sync URL used by the background worker (same DB, psycopg driver)
DATABASE_SYNC_URL=postgresql+psycopg://face:face@postgres:5432/face_recognition

# --- Storage ------------------------------------------------------------------
STORAGE_PATH=./storage
UNKNOWN_FACES_DIR=./storage/unknown_faces
SNAPSHOTS_DIR=./storage/snapshots
SNAPSHOT_ENABLED=true

# --- Security -----------------------------------------------------------------
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Static bearer token for the health/read endpoints or fallback auth (optional)
API_TOKEN=
# Simple in-memory rate limit for control endpoints: max requests per window
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# --- API -----------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
